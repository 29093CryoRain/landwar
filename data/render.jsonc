// 渲染配置：颜色比例在 [0,1]，尺寸和面积参数必须 > 0；导出时本文件复制到 default/。
{
  "render": {
    "_comment": "双色势力渲染（⑫）：tile=地块格填色 主:副:白 加权平均；city.mix=城市图标填色 主:副:黑 加权平均。",
    "windowWidth": 2560, // SDL 逻辑画布宽度，正整数。
    "windowHeight": 1600, // SDL 逻辑画布高度，正整数。
    "armyDrawSize": 48, // 兵种贴图逻辑边长，正整数。
    "tile": {
      "primary": 0.5, // 主色权重，必须 >= 0；与 secondary/white 一起决定地块颜色。
      "secondary": 0.3, // 副色权重，必须 >= 0。
      "white": 0.2, // 白色权重，必须 >= 0。
      "variation": 0.05 // 密铺分档时主副权重的摆动半宽，必须 >= 0。
    },
    "mountain": {
      "_comment": "sourceWidth/sourceHeight/segments 使用源图像素；strokeWidthPx 是预烘焙掩膜线宽，最终逻辑屏幕线宽还要按 blockSize×zoom/sourceWidth 换算。",
       "sourceWidth": 128, // mountain.png 源宽，正整数。
       "sourceHeight": 128, // mountain.png 源高，正整数。
       "strokeWidthPx": 6.0, // 源图线宽（像素），必须 > 0。
       "areaReference": 1.0, // 线稿面积缩放基准（U²），必须 > 0。
      "segments": [
        [0.0, 119.0, 47.0, 1.0],
        [47.0, 1.0, 92.3, 127.0],
        [79.0, 90.0, 98.0, 53.0],
        [98.0, 53.0, 127.0, 127.0]
      ],
       "colorDarken": 0.08 // 山纹颜色乘数，范围 [0,1]。
    },
    "city": {
      "_comment": "P13 城市渲染：所有密铺统一走 data/city_icon_fits.jsonc 的 iconFitScale，缺失按 1 倍缩放并告警。",
      "lineMinCellPx": 20.0, // 超过此单格像素尺寸时绘制城市细线，必须 > 0。
      "lineThickness": 1.5, // 普通城市细线宽度，必须 > 0。
      "lineDarken": 0.7, // 普通城市细线颜色乘数，范围 [0,1]。
      "iconDarken": 0.8, // 城市图标颜色乘数，范围 [0,1]。
      "mix": {
        "primary": 0.7, // 图标主色权重，范围 [0,1]。
        "secondary": 0.1, // 图标副色权重，范围 [0,1]。
        "black": 0.2 // 图标黑色权重，范围 [0,1]。
      },
      "spawnArrow": {
        "primary": 0.6, // 箭头主色权重，范围 [0,1]。
        "secondary": 0.1, // 箭头副色权重，范围 [0,1]。
        "black": 0.3, // 箭头黑色权重，范围 [0,1]。
        "areaDivisor": 2 // 箭头距离的面积除数，必须 > 0。
      }
    },
    "capital": {
      "_comment": "P15 首都渲染常数。",
      "minIconSizePx": 30, // 首都低缩放最小图标宽度，正整数。
      "lineThickness": 2.5, // 首都细线宽度，必须 > 0。
      "designatedAlpha": 0.45 // 候补首都透明度，范围 [0,1]。
    },
    "player": {
      "_comment": "城市选择命中与产兵指示参数；长度均按世界单位 U 解释。",
      "hoverCityRadius": 2.0, // 城市命中半径（U），必须 > 0。
      "markerAlpha": 0.85, // 选择指示透明度，范围 [0,1]。
      "markerRotateSpeed": 0.03, // 指示圈每 tick 旋转角（rad），必须有限。
      "markerRingMargin": 1.5, // 指示圈相对城市 AABB 的外扩边距（U），必须 >= 0。
      "markerArrowGap": 0.6 // 箭头尖端距城市 AABB 的间距（U），必须 >= 0。
    }
  }
}
