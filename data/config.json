{
  "_comment": "核心与模拟配置。长配置段拆分到 render.json、techs.json、factions.json、units.json；Config::loadFromFile 会按同目录片段合并。",
  "map": {
    "_comment": "地图文件/尺寸由菜单或 CLI 注入；这里保留模拟相关地图参数。",
    "blockSize": 15,
    "panelWidth": 600,
    "capitalMinDistance": 28,
    "cityMountainWeight": 0.3,
    "forceCoastRangeMultiplier": 3.2,
    "forceCoastStrengthMultiplier": 1.0
  },
  "army": {
    "baseSpeed": 0.15,
    "baseSize": 1,
    "bounceJitterRangeRad": 0.03,
    "spawnAngleStep": 2.0
  },
  "sea": {
    "_comment": "goSeaIncrease 为独立常量；势力下海倍率在 factions.json。",
    "initialGoSeaProbability": 1.0,
    "goSeaIncrease": 8.5e-05,
    "goSeaChanceConst": 110.0,
    "goSeaChanceDenominator": 17700.0,
    "seaSpeedMult": 0.5
  },
  "terrain": {
    "_comment": "地形基图 RGB 概率权重；任一分量<32→海，否则→陆。",
    "seaChannelMin": 32,
    "probFloor": 128,
    "probScale": 127,
    "mountainEnterChance": 0.5,
    "mountainSpeedMult": 0.5
  },
  "effect": {
    "bomb": {
      "lifetimeTicks": 16,
      "conquerEveryTicks": 4,
      "expansionRate": 0.5,
      "baseRadius": 2.4
    },
    "mine": {
      "radius": 1.4,
      "armTicks": 1200,
      "checkEveryTicks": 24,
      "timeoutTicks": 7200,
      "triggerRadius": 1.54,
      "triggerBombRadius": 1.1
    },
    "laser": {
      "durationTicks": 44,
      "length": 30.0,
      "extendPerTick": 1,
      "killExtraRadius": 0.1,
      "beamSpreadPIFrac": 0.0909091
    }
  },
  "projectile": {
    "_comment": "射弹全局参数。",
    "drawSize": 32,
    "mountainLifespanPenalty": 1
  },
  "economy": {
    "_comment": "逐 tick 收入参数；城市等级形状表在 city_shapes.json。",
    "initialEconomy": 1.1,
    "perLandIncome": 0.00007,
    "cityBaseMult": 20.0,
    "capitalBase": 0.2
  },
  "city": {
    "_comment": "城市经济与等级分布指数；全部密铺形状表在 city_shapes.json。",
    "levelIncomeExponent": 1.3,
    "levelRankExponent": 0.3
  },
  "capital": {
    "_comment": "首都迁都冷却参数。",
    "relocationDelayTicks": 1200
  },
  "sim": {
    "tickRate": 60.0,
    "maxArmyGuard": 2000
  },
  "ui": {
    "messageMaxShown": 12
  }
}
