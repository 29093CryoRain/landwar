// 势力配置：id 必须从 0 开始连续；颜色通道为 0..255，偏好系数必须 > 0；导出时本文件复制到 default/。
{
  "factions": [
    {
      // id 必须与数组下标一致且最终连续；name/description 用于菜单、消息和排行榜。
      "_comment": "id 0 = 中立灰占位（双色系统⑫）：主色=深灰、副色=浅灰。",
      "id": 0,
      "name": "中立",
      "description": "不参与战争的中立土地与城市。",
      "nameColors": ["primary"],
      "color": [96, 96, 96], // 主色 RGB，每通道整数 0..255。
      "secondary": [191, 191, 191] // 副色 RGB，每通道整数 0..255。
    },
    {
      "id": 1,
      "name": "红",
      "description": "偏好普通兵，擅长稳定推进。",
      "nameColors": ["primary"],
      "color": [255, 0, 0],
      "secondary": [191, 191, 191],
      "unitPreference": {"normal": 2.0},
      "buffs": []
    },
    {
      "id": 2,
      "name": "黄",
      "description": "均衡使用激光、炸弹和地雷。",
      "nameColors": ["primary"],
      "color": [255, 255, 0],
      "secondary": [191, 191, 191],
      "unitPreference": {"laser": 1.5, "bomb": 1.5, "mine": 1.5},
      "buffs": []
    },
    {
      "id": 3,
      "name": "青",
      "description": "偏好先锋，拥有更快的全军速度。",
      "nameColors": ["primary"],
      "color": [0, 255, 255],
      "secondary": [191, 191, 191],
      "unitPreference": {"vanguard": 3.0},
      "buffs": [
        {"type": "UnitSpeedAdd", "param": "all", "magnitude": 0.2},
        {"type": "SeaChanceMult", "param": "all", "magnitude": 0.666}
      ]
    },
    {
      "id": 4,
      "name": "蓝",
      "description": "偏好开拓，适合扩张和山地作战。",
      "nameColors": ["primary"],
      "color": [0, 85, 255],
      "secondary": [191, 191, 191],
      "unitPreference": {"pioneer": 3.0, "vanguard": 1.5},
      "buffs": [
        {"type": "BounceChanceMult", "param": "all", "magnitude": 0.8},
        {"type": "UnitSpeedAdd", "param": "pioneer", "magnitude": 0.5}
      ]
    },
    {
      "id": 5,
      "name": "绿",
      "description": "偏好激光，拥有更强的激光火力。",
      "nameColors": ["primary"],
      "color": [0, 255, 0],
      "secondary": [191, 191, 191],
      "unitPreference": {"laser": 3.0},
      "buffs": [
        {"type": "LaserExtraBeams", "param": "all", "magnitude": 2},
        {"type": "LaserDurationAdd", "param": "all", "magnitude": 0.5},
        {"type": "LaserLengthAdd", "param": "all", "magnitude": 0.5}
      ]
    },
    {
      "id": 6,
      "name": "橙",
      "description": "偏好炸弹，爆炸范围更大。",
      "nameColors": ["primary"],
      "color": [255, 127, 0],
      "secondary": [191, 191, 191],
      "unitPreference": {"bomb": 3.0},
      "buffs": [
        {"type": "BombExplosionRadiusAdd", "param": "bomb", "magnitude": 0.5}
      ]
    },
    {
      "id": 7,
      "name": "紫",
      "description": "偏好地雷，地雷爆炸范围更大。",
      "nameColors": ["primary"],
      "color": [127, 0, 255],
      "secondary": [191, 191, 191],
      "unitPreference": {"mine": 3.0},
      "buffs": [
        {"type": "MineExplosionRadiusAdd", "param": "mine", "magnitude": 0.5}
      ]
    },
    {
      "id": 8,
      "name": "品红",
      "description": "攻占城市时有机会获得免费兵力。",
      "nameColors": ["primary", "primary"],
      "color": [255, 0, 255],
      "secondary": [191, 191, 191],
      "buffs": [
        {"type": "FreeArmyChance", "param": "normal", "magnitude": 0.5}
      ]
    },
    {
      "id": 9,
      "name": "测试",
      "description": "用于debug",//这是一条注释, 用于测试.
      "nameColors": ["primary", "secondary"],
      "color": [255, 204, 181],
      "secondary": [168, 255, 89],
      "unitPreference": {"laser": 2, "bomb": 2, "mine": 2},
      "buffs": [
        {"type": "BombExplosionRadiusAdd", "param": "bomb", "magnitude": 0.5},
        {"type": "MineExplosionRadiusAdd", "param": "mine", "magnitude": 0.5},
        {"type": "UnitSpeedAdd", "param": "all", "magnitude": 0.5},
        {"type": "FreeArmyChance", "param": "laser", "magnitude": 0.5},
        {"type": "FreeArmyChance", "param": "bomb", "magnitude": 0.5},
        {"type": "LaserExtraBeams", "param": "all", "magnitude": 2},
        {"type": "LaserDurationAdd", "param": "all", "magnitude": 0.5},
        {"type": "LaserLengthAdd", "param": "all", "magnitude": 0.5},
        {"type": "BounceChanceMult", "param": "all", "magnitude": 0.8}
      ]
    }
  ]
}
