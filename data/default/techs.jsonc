// 科技配置：levels[i] 是第 i+1 级累计效果；magnitude 必须为有限数；导出时本文件复制到 default/。
{
  "tech": {
    "_comment": "P8 科技系统（思路'科技细节'）。科技点=城市产出；到阈值清空+科研机会、阈值+thresholdStep。levels[i]=第i+1级累计效果；preferenceUnits=每级默认 AI 兵种偏好加成。",
    "thresholdBase": 100.0, // 首次科研所需科技点，必须 > 0。
    "thresholdStep": 100.0, // 每次科研后阈值增加量，必须 > 0。
    "pointsPerCityLevel": 0.005, // 每 tick 每座每级城市产生的科技点，必须 >= 0。
    "preferencePerLevel": 0.5, // 科技每升一级给默认 AI 的偏好增量，必须 >= 0。
    "playerCandidateCount": 3, // 玩家科研候选数，必须 > 0。
    "techs": [
      {
        "id": "throttle_normal",
        "name": "节流·普通兵",
        "desc": "造价",
        "levels": [ // 每个元素是该科技对应等级的累计效果，不是本级增量。
          {"type": "UnitCostMult", "param": "normal", "magnitude": 0.9},
          {"type": "UnitCostMult", "param": "normal", "magnitude": 0.82},
          {"type": "UnitCostMult", "param": "normal", "magnitude": 0.75},
