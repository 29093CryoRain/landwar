// 核心配置文件。导出发行版时，本文件会复制到 data/default/config.jsonc 作为回退副本。
{
  "_comment": "核心与模拟配置。长配置段拆分到 render.jsonc、techs.jsonc、factions.jsonc、units.jsonc；Config::loadFromFile 会按同目录片段合并。",
  "map": { // blockSize/panelWidth/capitalMinDistance 为整数；blockSize > 0，其余距离/倍率 >= 0。
    "_comment": "地图文件/尺寸由菜单或 CLI 注入；这里保留模拟相关地图参数。",
    "blockSize": 15, // 正方形单格逻辑像素边长，必须 > 0。
    "panelWidth": 600, // 左侧面板宽度，必须 >= 0。
    "capitalMinDistance": 28, // 首都候选点最小距离，必须 >= 0。
    "cityMountainWeight": 0.3, // 山地格相对普通陆地的城市权重，必须 >= 0。
    "forceCoastRangeMultiplier": 3.2, // 强制边缘海影响范围倍率，必须 >= 0。
    "forceCoastStrengthMultiplier": 1.0, // 边缘海拔衰减强度倍率，必须 >= 0。
    "tiling": "square" // 密铺名称，必须是 schema 中列出的已注册密铺。
  },
  "army": { // 速度/尺寸为正数；弧度抖动可为 0，所有数值必须有限。
    "baseSpeed": 0.15, // 普通兵基础速度（U/tick），必须 > 0。
    "baseSize": 1, // 基础碰撞半径（U），必须 > 0。
    "bounceJitterRangeRad": 0.03, // 反弹随机角半区间（rad），必须 >= 0。
    "spawnAngleStep": 2.0 // 同城连续产兵方向逆时针步进角（rad）。
  },
  "sea": { // 初始概率在 [0,1]；增量/常数 >= 0；分母和速度倍率 > 0。
    "_comment": "goSeaIncrease 为每 tick 的独立增量；势力下海倍率在 factions.jsonc。",
    "initialGoSeaProbability": 1.0, // 新生成兵的初始下海概率，范围 [0,1]。
    "goSeaIncrease": 8.5e-05, // 等待下海时每 tick 增加的概率，必须 >= 0。
    "goSeaChanceConst": 110.0, // 下海概率公式的常数项，必须 >= 0。
    "goSeaChanceDenominator": 17700.0, // 下海概率公式分母，必须 > 0。
    "seaSpeedMult": 0.5 // 下海速度乘数，登陆时使用其倒数，必须 > 0。
  },
  "terrain": { // 通道/概率参数为 0..255；山地进入概率在 [0,1]，速度倍率 > 0。
    "_comment": "地形基图 RGB 概率权重；任一分量<32→海，否则→陆。",
    "seaChannelMin": 32, // 任一 RGB 通道小于此值的格确定为海，整数 0..255。
    "probFloor": 128, // 概率 ramp 的 0 点，整数 0..255。
    "probScale": 127, // 概率 ramp 的缩放分母，整数 1..255。
    "mountainEnterChance": 0.5, // 普通兵进入山地的基础概率，范围 [0,1]。
    "mountainSpeedMult": 0.5 // 进入山地后的速度乘数，必须 > 0。
  },
  "effect": { // tick 间隔必须 > 0（armTicks 可为 0）；倍率/半径必须 > 0。
    "bomb": {
      "lifetimeTicks": 16,
      "conquerEveryTicks": 4,
      "expansionRate": 0.5,
      "baseRadius": 2.4
    },
    "mine": {
      "radius": 1.4,
      "armTicks": 1200,
      "checkEveryTicks": 24,
      "timeoutTicks": 7200,
      "triggerRadius": 1.54,
      "triggerBombRadius": 1.1
    },
    "laser": {
      "durationTicks": 44,
      "length": 30.0,
      "extendPerTick": 1,
      "killExtraRadius": 0.1,
      "beamSpreadPIFrac": 0.0909091
    }
  },
  "projectile": { // drawSize > 0；山地寿命惩罚为非负整数。
    "_comment": "射弹全局参数。",
    "drawSize": 32,
    "mountainLifespanPenalty": 1
  },
  "economy": { // 收入/初始库存必须 >= 0；capitalBase 可为任意有限数。
    "_comment": "逐 tick 收入参数；城市等级形状表在 city_shapes.json。",
    "initialEconomy": 1.1,
    "perLandIncome": 0.00007,
    "cityBaseMult": 20.0,
    "capitalBase": 0.2
  },
  "city": { // 两个指数必须有限且非负；levelRankExponent 必须 > 0。
    "_comment": "城市经济与等级分布指数；全部密铺形状表在 city_shapes.json。",
    "levelIncomeExponent": 1.3,
    "levelRankExponent": 0.3
  },
  "capital": { // 迁都冷却 tick 数必须 >= 0。
    "_comment": "首都迁都冷却参数。",
    "relocationDelayTicks": 1200
  },
  "sim": { // tickRate > 0；maxArmyGuard 为正整数。
    "tickRate": 60.0,
    "maxArmyGuard": 2000
  },
  "ui": {
    "messageMaxShown": 12 // 消息面板上限，必须 > 0。
  }
}
