// 科技配置：id/name/desc 已外置到 techs.csv，本文件只保留全局标量（阈值、点数系数等）
// 与每个科技的 levels（等级累计效果）和 preferenceUnits。id 仅作连接键。
// levels[i] 是第 i+1 级的**一组**累计效果（数组的数组；一级可多条，如"密集防御"= 造价 + 禁征服）；
// magnitude 必须为有限数；导出时本文件与 techs.csv 一并复制到 default/。
{
  "tech": {
    "_comment": "P8 科技系统（思路'科技细节'）。科技点=城市产出；到阈值清空+科研机会、阈值+thresholdStep。levels[i]=第i+1级的一组累计效果；preferenceUnits=每级默认 AI 兵种偏好加成。",
    "thresholdBase": 100.0, // 首次科研所需科技点，必须 > 0。
    "thresholdStep": 100.0, // 每次科研后阈值增加量，必须 > 0。
    "pointsPerCityLevel": 0.005, // 每 tick 每座每级城市产生的科技点，必须 >= 0。
    "preferencePerLevel": 0.5, // 科技每升一级给默认 AI 的偏好增量，必须 >= 0。
    "playerCandidateCount": 3, // 玩家科研候选数，必须 > 0。
    "techs": [ // 每个元素 = 一级的一组效果（取当前级时整组生效，不叠加低等级）。
      {
        "id": "throttle_normal",
        "levels": [
          [{"type": "UnitCostMult", "param": "normal", "magnitude": 0.9}],
          [{"type": "UnitCostMult", "param": "normal", "magnitude": 0.82}],
          [{"type": "UnitCostMult", "param": "normal", "magnitude": 0.75}],
          [{"type": "UnitCostMult", "param": "normal", "magnitude": 0.7}]
        ],
        "preferenceUnits": ["normal"]
      },
      {
        "id": "throttle_vanguard",
        "levels": [
          [{"type": "UnitCostMult", "param": "vanguard", "magnitude": 0.9}],
          [{"type": "UnitCostMult", "param": "vanguard", "magnitude": 0.82}],
          [{"type": "UnitCostMult", "param": "vanguard", "magnitude": 0.75}]
        ],
        "preferenceUnits": ["vanguard"]
      },
      {
        "id": "throttle_pioneer",
        "levels": [
          [{"type": "UnitCostMult", "param": "pioneer", "magnitude": 0.9}],
          [{"type": "UnitCostMult", "param": "pioneer", "magnitude": 0.82}],
          [{"type": "UnitCostMult", "param": "pioneer", "magnitude": 0.75}]
        ],
        "preferenceUnits": ["pioneer"]
      },
      {
        "id": "throttle_laser",
        "levels": [
          [{"type": "UnitCostMult", "param": "laser", "magnitude": 0.9}],
          [{"type": "UnitCostMult", "param": "laser", "magnitude": 0.82}],
          [{"type": "UnitCostMult", "param": "laser", "magnitude": 0.75}]
        ],
        "preferenceUnits": ["laser"]
      },
      {
        "id": "throttle_bomb",
        "levels": [
          [{"type": "UnitCostMult", "param": "bomb", "magnitude": 0.9}],
          [{"type": "UnitCostMult", "param": "bomb", "magnitude": 0.82}],
          [{"type": "UnitCostMult", "param": "bomb", "magnitude": 0.75}]
        ],
        "preferenceUnits": ["bomb"]
      },
      {
        "id": "throttle_mine",
        "levels": [
          [{"type": "UnitCostMult", "param": "mine", "magnitude": 0.9}],
          [{"type": "UnitCostMult", "param": "mine", "magnitude": 0.82}],
          [{"type": "UnitCostMult", "param": "mine", "magnitude": 0.75}]
        ],
        "preferenceUnits": ["mine"]
      },
      {
        "id": "throttle_pistol",
        "levels": [
          [{"type": "UnitCostMult", "param": "pistol", "magnitude": 0.9}],
          [{"type": "UnitCostMult", "param": "pistol", "magnitude": 0.82}],
          [{"type": "UnitCostMult", "param": "pistol", "magnitude": 0.75}]
        ],
        "preferenceUnits": ["pistol"]
      },
      {
        "id": "throttle_shotgun",
        "levels": [
          [{"type": "UnitCostMult", "param": "shotgun", "magnitude": 0.9}],
          [{"type": "UnitCostMult", "param": "shotgun", "magnitude": 0.82}],
          [{"type": "UnitCostMult", "param": "shotgun", "magnitude": 0.75}]
        ],
        "preferenceUnits": ["shotgun"]
      },
      {
        "id": "march_normal",
        "levels": [
          [{"type": "UnitSpeedAdd", "param": "normal", "magnitude": 0.2}],
          [{"type": "UnitSpeedAdd", "param": "normal", "magnitude": 0.4}],
          [{"type": "UnitSpeedAdd", "param": "normal", "magnitude": 0.6}],
          [{"type": "UnitSpeedAdd", "param": "normal", "magnitude": 0.8}]
        ],
        "preferenceUnits": ["normal"]
      },
      {
        "id": "march_vanguard",
        "levels": [
          [{"type": "UnitSpeedAdd", "param": "vanguard", "magnitude": 0.2}],
          [{"type": "UnitSpeedAdd", "param": "vanguard", "magnitude": 0.4}],
          [{"type": "UnitSpeedAdd", "param": "vanguard", "magnitude": 0.6}]
        ],
        "preferenceUnits": ["vanguard"]
      },
      {
        "id": "march_pioneer",
        "levels": [
          [{"type": "UnitSpeedAdd", "param": "pioneer", "magnitude": 0.2}],
          [{"type": "UnitSpeedAdd", "param": "pioneer", "magnitude": 0.4}],
          [{"type": "UnitSpeedAdd", "param": "pioneer", "magnitude": 0.6}]
        ],
        "preferenceUnits": ["pioneer"]
      },
      {
        "id": "march_laser",
        "levels": [
          [{"type": "UnitSpeedAdd", "param": "laser", "magnitude": 0.2}],
          [{"type": "UnitSpeedAdd", "param": "laser", "magnitude": 0.4}],
          [{"type": "UnitSpeedAdd", "param": "laser", "magnitude": 0.6}]
        ],
        "preferenceUnits": ["laser"]
      },
      {
        "id": "march_bomb",
        "levels": [
          [{"type": "UnitSpeedAdd", "param": "bomb", "magnitude": 0.2}],
          [{"type": "UnitSpeedAdd", "param": "bomb", "magnitude": 0.4}],
          [{"type": "UnitSpeedAdd", "param": "bomb", "magnitude": 0.6}]
        ],
        "preferenceUnits": ["bomb"]
      },
      {
        "id": "march_mine",
        "levels": [
          [{"type": "UnitSpeedAdd", "param": "mine", "magnitude": 0.2}],
          [{"type": "UnitSpeedAdd", "param": "mine", "magnitude": 0.4}],
          [{"type": "UnitSpeedAdd", "param": "mine", "magnitude": 0.6}]
        ],
        "preferenceUnits": ["mine"]
      },
      {
        "id": "big_bang",
        "levels": [
          [{"type": "ExplosionRadiusAdd", "param": "all", "magnitude": 0.3}],
          [{"type": "ExplosionRadiusAdd", "param": "all", "magnitude": 0.6}],
          [{"type": "ExplosionRadiusAdd", "param": "all", "magnitude": 0.8}]
        ],
        "preferenceUnits": ["bomb", "mine"]
      },
      {
        "id": "stable_laser",
        "levels": [
          [{"type": "LaserDurationAdd", "param": "all", "magnitude": 0.5}],
          [{"type": "LaserDurationAdd", "param": "all", "magnitude": 1.0}]
        ],
        "preferenceUnits": ["laser"]
      },
      {
        "id": "extend_laser",
        "levels": [
          [{"type": "LaserLengthAdd", "param": "all", "magnitude": 0.5}],
          [{"type": "LaserLengthAdd", "param": "all", "magnitude": 1.0}]
        ],
        "preferenceUnits": ["laser"]
      },
      {
        "id": "rapid_fire",
        "levels": [
          [{"type": "UnitActionRateAdd", "param": "pistol", "magnitude": 0.3}],
          [{"type": "UnitActionRateAdd", "param": "pistol", "magnitude": 0.6}],
          [{"type": "UnitActionRateAdd", "param": "pistol", "magnitude": 0.9}]
        ],
        "preferenceUnits": ["pistol"]
      },
      {
        "id": "barrage",
        "levels": [
          [{"type": "ProjectileCountExtra", "param": "shotgun", "magnitude": 2.0}],
          [{"type": "ProjectileCountExtra", "param": "shotgun", "magnitude": 3.0}],
          [{"type": "ProjectileCountExtra", "param": "shotgun", "magnitude": 4.0}]
        ],
        "preferenceUnits": ["shotgun"]
      },
      {
        "id": "economy_boost",
        "levels": [
          [{"type": "EconomyGainAdd", "param": "all", "magnitude": 0.05}],
          [{"type": "EconomyGainAdd", "param": "all", "magnitude": 0.1}],
          [{"type": "EconomyGainAdd", "param": "all", "magnitude": 0.15}],
          [{"type": "EconomyGainAdd", "param": "all", "magnitude": 0.2}]
        ],
        "preferenceUnits": []
      },
      {
        "id": "observatory",
        "levels": [
          [{"type": "TechGainAdd", "param": "all", "magnitude": 0.1}],
          [{"type": "TechGainAdd", "param": "all", "magnitude": 0.2}],
          [{"type": "TechGainAdd", "param": "all", "magnitude": 0.3}],
          [{"type": "TechGainAdd", "param": "all", "magnitude": 0.4}]
        ],
        "preferenceUnits": []
      },
      {
        // 密集防御（科技开发列表）：普通兵失去征服敌方陆格的能力，但造价 -50%。
        // 一级两条效果 = 机制（UnitNoEnemyConquer）+ 数值（UnitCostMult）。
        "id": "dense_defense",
        "levels": [
          [
            {"type": "UnitCostMult", "param": "normal", "magnitude": 0.5},
            {"type": "UnitNoEnemyConquer", "param": "normal", "magnitude": 1.0}
          ]
        ],
        "preferenceUnits": ["normal"]
      }
    ]
  }
}
