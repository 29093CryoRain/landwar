// 兵种配置：核心单值列（type/cost/speedMult/sizeMult/bounceMult/visualRadius）已外置到 units.csv，
// 本文件只保留各兵种的独有/可选字段（山地特性、亡语、周期动作、射弹参数等）。
// 条目按 "type" 与 units.csv 的行对应；没有额外字段的兵种（normal/vanguard/laser/bomb/mine）
// 无需在此出现。省略字段保留 Config.h 默认值；导出时本文件与 units.csv 一并复制到 default/。
{
  "units": [ // type 必须唯一且为已注册兵种。
    {
      "type": "pioneer",
      "mountainEnterMult": 2,
      "mountainNoSlow": true
    },
    {
      "type": "pistol",
      "_comment": "手枪（P9 射弹兵）：每 240 tick 向正前方发 1 颗恒定速度 0.25 U/tick 的子弹，寿命 180 tick（3s）。自身速度 0.5×、碰撞半径 1.3×（暂定）。",
      "mountainEnterMult": 1.0,
      "mountainNoSlow": false,
      "deathEffect": "none",
      "periodic": "pistol",
      "periodTicks": 240,
      "bulletSpeed": 0.25,
      "bulletSpeedJitter": 0.0,
      "bulletCount": 1,
      "bulletLifespanTicks": 180,
      "bulletSize": 0.3,
      "bulletSpreadPIFrac": 0.0,
      "bulletSpreadJitterFrac": 0.3
    },
    {
      "type": "shotgun",
      "_comment": "霰弹（P9 射弹兵）：每 360 tick 向正前方 40° 扇形（均布占位 -20°/0/+20° + 轻抖动，避免三弹全偏一侧）发 3 颗随机速度（1/6±1/30 U/tick = 基准值 0.8~1.2 倍），寿命 120 tick（2s）。",
      "mountainEnterMult": 1.0,
      "mountainNoSlow": false,
      "deathEffect": "none",
      "periodic": "shotgun",
      "periodTicks": 360,
      "bulletSpeed": 0.16666666666666666,
      "bulletSpeedJitter": 0.03333333333333333,
      "bulletCount": 3,
      "bulletLifespanTicks": 120,
      "bulletSize": 0.3,
      "bulletSpreadPIFrac": 0.222222,
      "bulletSpreadJitterFrac": 0.3
    }
  ]
}
